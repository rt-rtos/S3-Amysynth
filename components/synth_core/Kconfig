menu "Sequencer Defaults"

config SYNTH_DEV_MENU
	bool "DEV menu (temporary/test controls)"
	default y
	help
		Adds a DEV entry at the top of the main menu hosting temporary
		test controls, runtime diagnostics and readouts (ui_screen_dev.c).
		Controls graduate to real screens if they prove out; disable for
		a clean end-user build - no DEV code is compiled in when off.

config SEQ_STATE_IN_PSRAM
	bool "Place sequencer layer tables in PSRAM"
	depends on SPIRAM
	default y
	help
		Allocate the sequencer core layer table (s_layers, ~7.5 KB) and the
		UI mirror state (seq_state, ~7.5 KB) from PSRAM at init instead of
		static internal DRAM, freeing ~15 KB of internal RAM. Accesses run
		through the data cache; the sequencer tick reads the layer table
		per block, so disable this if a render-path regression is ever
		traced here. Falls back to internal heap if the PSRAM allocation
		fails (and aborts at boot if both fail - this state is not
		optional). When disabled, both tables are static internal arrays
		exactly as before.

config SEQ_QUANTIZER_DEFAULT_ENABLED
	bool "Enable quantizer by default"
	default y
	help
		Initializes the melodic quantizer as enabled at boot.

config SEQ_QUANTIZER_DEFAULT_ROOT_NOTE
	int "Quantizer default root MIDI note"
	range 0 127
	default 60
	help
		Default quantizer root note at startup (60 = C4).

config SEQ_QUANTIZER_DEFAULT_SCALE
	int "Quantizer default scale index"
	range 0 8
	default 3
	help
		Default quantizer scale index at startup.
		0=Chromatic, 1=Major, 2=Natural Minor, 3=Dorian,
		4=Phrygian, 5=Lydian, 6=Mixolydian,
		7=Minor Pentatonic, 8=Major Pentatonic.

config SEQ_MELODIC_EXPRESSIVE_DEFAULTS
	bool "Enable expressive melodic defaults"
	default y
	help
		Enables melodic step velocity accents and uses the configured melodic
		gate ratio. If disabled, melodic velocity defaults to 1.0 and the gate
		falls back to the original 2/3-step duration.

choice SEQ_MELODIC_PATCH_PRESET
	prompt "Melodic layer AMY patch preset"
	default SEQ_MELODIC_PATCH_SINE
	help
		Selects which built-in AMY patch number the sequencer uses when
		creating melodic layers.

config SEQ_MELODIC_PATCH_JUNO_EPIANO1
	bool "Juno E PIANO 1 (patch 14)"

config SEQ_MELODIC_PATCH_JUNO_SYNTH_BASS2
	bool "JUNO SYNTH BASS 2 (patch 36)"

config SEQ_MELODIC_PATCH_JUNO_CHORUS_VIBES
	bool "JUNO CHORUS VIBES (patch 66)"

config SEQ_MELODIC_PATCH_JUNO_SYNTH_PAD
	bool "JUNO SYNTH PAD (patch 47)"

config SEQ_MELODIC_PATCH_JUNO_PIANO1
	bool "Juno A18 Piano I (patch 7)"

config SEQ_MELODIC_PATCH_JUNO_EPIANO_TREM
	bool "Juno B61 E. Piano with Tremolo (patch 104)"

config SEQ_MELODIC_PATCH_PIANO_BUILTIN
	bool "AMY built-in piano (patch 256)"

config SEQ_MELODIC_PATCH_SINE
	bool "Raw SINE waveform (patch 257)"

config SEQ_MELODIC_PATCH_CUSTOM_START
	bool "start of custom presets/raw waveforms"

endchoice

config SEQ_MELODIC_DISABLE_DEFAULT_LPF
	bool "Strip the patch-baked filter from fresh melodic voices"
	default n
	help
		Built-in AMY Juno/DX7 patch strings carry their own filter block
		(a G/F/R command trio -> filter_type/cutoff/resonance), so a freshly
		created melodic voice inherits that patch's low-pass filter before the
		user has authored anything in the filter editor.

		Enable this to push a FILTER_NONE event to every UNAUTHORED melodic
		row right after the patch loads, giving the raw, unfiltered patch tone.
		Rows the user has explicitly dialed in the filter editor
		(filter_authored) are never touched, so authored filters still win.

config SEQ_MELODIC_PATCH
	int
	default 14 if SEQ_MELODIC_PATCH_JUNO_EPIANO1
	default 32 if SEQ_MELODIC_PATCH_JUNO_SYNTH_BASS2
	default 66 if SEQ_MELODIC_PATCH_JUNO_CHORUS_VIBES
	default 47 if SEQ_MELODIC_PATCH_JUNO_SYNTH_PAD
	default 7 if SEQ_MELODIC_PATCH_JUNO_PIANO1
	default 104 if SEQ_MELODIC_PATCH_JUNO_EPIANO_TREM
	default 256 if SEQ_MELODIC_PATCH_PIANO_BUILTIN
	default 257 if SEQ_MELODIC_PATCH_SINE
	default 1 if SEQ_MELODIC_PATCH_CUSTOM_START
	help
		Resolved AMY patch number for melodic layer initialization.

config SEQ_MEL_VOICES
	int "Voices per melodic row"
	range 1 4
	default 1
	help
		One AMY synth is allocated PER ROW (per track). A row only ever
		sounds one pitch at a time, so a single voice suffices. Bump to 2
		to give note-off/note-on overlap headroom at the step boundary, at
		2x oscillator cost per row. Melodic rows span slots 11..62, so
		higher values multiply oscillator use against AMY's 250-osc budget.

choice SEQ_PATCH_BROWSE_MODE
	prompt "Runtime melodic patch browse mode"
	default SEQ_PATCH_BROWSE_PRESELECTED
	help
		Controls what the runtime patch-select control (hold BPM button + turn
		encoder) cycles through.

config SEQ_PATCH_BROWSE_PRESELECTED
	bool "Preselected shortlist"
	help
		Cycle a small, hand-picked list of musical built-in patches. Fast to
		reach favourites; does not require the name table.

config SEQ_PATCH_BROWSE_FULL_RANGE
	bool "Full range (0..256)"
	help
		Cycle every AMY built-in patch: Juno 0..127, DX7 128..255, and the
		built-in piano (256). Enable SEQ_PATCH_SHOW_NAMES to see what each is.

endchoice

config SEQ_PATCH_SHOW_NAMES
	bool "Show human-readable patch names"
	default y if SEQ_PATCH_BROWSE_FULL_RANGE
	default n
	help
		Compiles in a table of human-readable patch names (e.g. "DX7 E.Piano 1")
		and shows them on the OLED instead of the bare patch number. Costs flash
		(≈257 short strings + a pointer table). Disable to save flash — useful
		for preselected-only builds, or when browsing the full range under flash
		pressure (you then see just the patch number). The number is always
		shown; the name is appended only when this is enabled.

config SEQ_MELODIC_GATE_NUMERATOR
	int "Melodic gate ratio numerator"
	range 1 12
	default 11
	help
		Numerator used to compute melodic note gate duration. A ratio close
		to 1 (e.g. 11/12) makes notes near-legato so they connect instead of
		stabbing; combined with the EG0 release this gives a sustained tail
		rather than the original short "car horn" staccato.

config SEQ_MELODIC_GATE_DENOMINATOR
	int "Melodic gate ratio denominator"
	range 1 12
	default 12
	help
		Denominator used to compute melodic note gate duration.

config SEQ_DRUM_GATE_NUMERATOR
	int "Drum gate ratio numerator"
	range 1 12
	default 3
	help
		Numerator for the drum note gate duration (fraction of one step the
		note is held before its note-off). Drums are now real Juno patches with
		note-offs honored, so this controls choke vs. ring: a short gate (e.g.
		1/2) chokes the patch quickly for a tight percussive feel; the patch's
		own release tail still plays after note-off.

config SEQ_DRUM_GATE_DENOMINATOR
	int "Drum gate ratio denominator"
	range 1 12
	default 4
	help
		Denominator for the drum note gate duration.

config SEQ_MELODIC_ENVELOPE_ENABLED
	bool "Apply melodic EG0 envelope defaults"
	default y
	help
		Sends a startup EG0 envelope configuration to melodic synth layers so
		note onsets and tails are shaped (soft attack, audible release) instead
		of being hard-gated. Disable to fall back to the raw patch envelope.

config SEQ_MELODIC_ENV_EG0_TYPE
	int "Melodic EG0 envelope type"
	range 0 3
	default 0
	help
		0=Normal, 1=Linear, 2=DX7-style, 3=True exponential.
		Use 0 (Normal) for a smooth, musical amplitude envelope. Type 2 (DX7)
		is meant for DX7-style level tables and sounds wrong when applied to a
		plain attack/decay/sustain/release breakpoint set.

config SEQ_MELODIC_ENV_ATTACK_MS
	int "Melodic envelope attack (ms)"
	range 0 5000
	default 4

config SEQ_MELODIC_ENV_DECAY_MS
	int "Melodic envelope decay (ms)"
	range 0 10000
	default 250

config SEQ_MELODIC_ENV_SUSTAIN_PCT
	int "Melodic envelope sustain level (%)"
	range 0 100
	default 30

config SEQ_MELODIC_ENV_RELEASE_MS
	int "Melodic envelope release (ms)"
	range 0 10000
	default 200

config SEQ_ADSR_EXPLICIT_DECAY
	bool "Explicit decay control in the ADSR editor (industry-norm)"
	default y
	help
		Controls how the DECAY time is handled in the graph ADSR editors
		(EG0 and EG1, across melodic/drone/arp targets).

		Enabled (default, industry norm): decay is a first-class control.
		The sustain point becomes draggable on BOTH axes - horizontal sets
		the decay TIME (in ms, read out on the top bar as "D ..ms") and
		vertical sets the sustain LEVEL. The encoder button cycles the
		sustain point between level and decay-time while adjusting. The
		stored per-voice decay_ms is shown and edited literally.

		Disabled: the legacy behaviour where decay TIME is derived, not
		dragged. The sustain point is level-only (Y) and its decay time is
		auto-computed from the attack time and sustain level
		(decay = clamp(120 + 0.5*attack + 400*(1-sustain), 20, 2000) ms).

		This is a compile-time behaviour switch; changing it requires a
		clean rebuild so the ADSR editor picks up the new mode.

config SEQ_ENV_DEBUG_DUMP
	bool "Log envelope events sent to AMY on commit"
	default n
	help
		Temporary verification aid. When enabled, committing an envelope in the
		graph editor logs the exact breakpoint event sent to the row's AMY synth
		(target synth, eg_type, attack/decay/release ms and sustain level), so
		you can confirm on hardware that edits reach the oscillators. Leave off
		for normal builds.

config SEQ_MELODIC_AMY_NATIVE_LFO
	bool "Use AMY built-in LFO for melodic wave patches"
	default y
	help
		When enabled, melodic tracks using wave patches (SINE, SAW, etc.)
		drive the LFO via AMY's native modulation oscillator (osc 1 per
		voice, mod_source=1), mirroring the arp implementation.  Bass and
		Juno/DX7 patch-based tracks continue to use the software service
		loop so there is no regression on those patch types.
		PAN target and RANDOM waveform always fall back to the software
		path even when this option is enabled, since the AMY native LFO
		does not support them (same limitation as the arp).
		Disable to revert all melodic LFO to the software accumulator.

config SEQ_DIST_DRIVE_AMP_EG
	bool "Amp envelope (EG0) modulates distortion drive (WIP)"
	default n
	help
		PROTOTYPE / experimental. Routes each voice's amplitude envelope
		(EG0) into the per-osc distortion DRIVE via AMY's control-coef rail.
		Drive is a log2 rail, so - exactly like a filter EG sweeps cutoff -
		the unipolar 0..1 envelope adds a SIGNED octave depth
		(SEQ_DIST_DRIVE_AMP_EG_DEPTH_Q) of pre-gain: full at the attack peak,
		tapering to the authored drive at the release tail. Positive depth
		means louder/attack = more grit (as a real overdrive stage responds
		to level); a negative depth instead pulls drive DOWN as the note
		swells.

		Applies wherever distortion is authored (melodic, arp, live, drone) -
		they share voice_apply_dist. The authored drive is the floor; EG0's
		sustain level holds a proportional boost for the note's length, since
		drive's contour is shared with amplitude (AMY has only two envelopes,
		both already spoken for - amp and filter).

		Off by default; adding the symbol needs a clean rebuild. TODO: if it
		earns its keep, promote to a per-track amount with an EG0/EG1 source
		choice (see the dist coef rail in AMY-EDITS.md).

config SEQ_DIST_DRIVE_AMP_EG_DEPTH_Q
	int "  Drive EG depth (quarter-octaves, signed)"
	depends on SEQ_DIST_DRIVE_AMP_EG
	range -16 16
	default 4
	help
		EG0-into-drive depth in quarter-octaves at the envelope peak:
		4 = +1.0 oct (up to 2x drive), 16 = +4 oct (the rail's clamp).
		Negative values sweep drive DOWN as the envelope rises. Value-only
		change, so tunable in menuconfig without a clean rebuild once the
		toggle above is on.

config SYNTH_CUSTOM_FM
	bool "Custom FM/DX7 6-operator voices (WIP)"
	default n
	help
		Compiles in the custom DX7-style 6-operator FM/ALGO melodic voices:
		the fixed FM presets (FM Bass/E.Piano/Bell/Lead), the live-editable
		FM Custom voice, plus the "Screen: FM" menu entry and its editor.

		Work in progress and off by default. When disabled, none of the FM
		voice code, presets, or editor screen is built; the FM patch numbers
		(272-276) are dropped from the runtime patch browser; and the FM menu
		entry is hidden.

config SYNTH_ADDITIVE
	bool "Additive/partials voices (WIP)"
	default n
	help
		Compiles in the additive-synthesis melodic voices built on AMY's
		BYO_PARTIALS wave type: the fixed presets (Add Organ, Add Bell) and
		the live-editable Add Custom voice. Each voice is one control osc
		plus up to 12 PARTIAL sine oscs, so it costs N+1 oscillators from
		the global pool per sounding voice.

		Work in progress and off by default. When disabled, none of the
		additive voice code or presets is built and the additive patch
		numbers (277-279) are dropped from the runtime patch browser.

comment "Arpeggiator"

config SEQ_ARP_DEFAULT_ENABLED
	bool "Arp enabled by default"
	default n
	help
		Whether the standalone arpeggiator runs at boot. It plays on its own
		AMY synth, in sync with the global tempo, alongside the sequencer.

config SEQ_ARP_DEFAULT_SCALE
	int "Arp default scale index"
	range 0 8
	default 0
	help
		The arp's own quantizer scale, used while the ArpQ menu row is OWN.
		Note slots store raw chromatic notes and are snapped to this scale at
		playback. There is no on-device editor for it, so the default is
		Chromatic: OWN then means "no snapping", the useful opposite of GLOB
		(the chord progression still re-roots the arp while it is enabled).
		0=Chromatic, 1=Major, 2=Natural Minor, 3=Dorian, 4=Phrygian,
		5=Lydian, 6=Mixolydian, 7=Minor Pentatonic, 8=Major Pentatonic.

config SEQ_ARP_DEFAULT_ROOT_NOTE
	int "Arp default root MIDI note"
	range 0 127
	default 40
	help
		The arp's own quantizer root note (60 = C4).

config SEQ_ARP_DEFAULT_GATE_PCT
	int "Arp default gate length (%)"
	range 10 100
	default 75
	help
		Fraction of each arp step the note is held before its note-off.

config SEQ_ARP_DEFAULT_OCTAVES
	int "Arp default octave span"
	range 1 4
	default 1
	help
		How many octaves the arp walks through before repeating.

config SEQ_ARP_DEFAULT_PATCH
	int "Arp default patch number"
	range 0 256
	default 138
	help
		AMY built-in patch for the arp synth (0..127 Juno, 128..255 DX7,
		256 built-in piano). 138 = DX7 E.Piano 1.


menu "Global FX Defaults"

config SEQ_FX_DEFAULT_ECHO
	int "Default echo level (0..100)"
	range 0 100
	default 0
	help
		Boot-time echo (delay) wet level, scaled to 0..1 before sending to
		AMY. 0 = off, 100 = full wet. Adjustable at runtime via the FX menu.

config SEQ_FX_DEFAULT_REVERB
	int "Default reverb level (0..100)"
	range 0 100
	default 0
	help
		Boot-time reverb wet level, scaled to 0..1 before sending to AMY.
		0 = off, 100 = full wet. Adjustable at runtime via the FX menu.

config SEQ_FX_DEFAULT_CHORUS
	int "Default chorus level (0..100)"
	range 0 100
	default 0
	help
		Boot-time chorus wet level, scaled to 0..1 before sending to AMY.
		0 = off, 100 = full wet. Adjustable at runtime via the FX menu.
		Applies to bus 0 (Bus 1 Main); split-off buses start at 0.
		Note: every AMY built-in Juno patch string overwrites the chorus of
		the bus it loads onto; synth_ui_fx_reassert() re-imposes this value
		after each patch load when "Preset FX" is off.

endmenu

config SYNTH_PROJECT_STORE
	bool "Persistent project storage (Projects menu)"
	default y
	help
		Save/load full session snapshots to the 'storage' LittleFS
		partition. Adds the Projects page to the main menu.

config SYNTH_PROJECT_MAX_SLOTS
	int "Project slots"
	depends on SYNTH_PROJECT_STORE
	range 1 64
	default 32

config SYNTH_PROJECT_SELFTEST
	bool "Project serializer boot self-test (diagnostic)"
	depends on SYNTH_PROJECT_STORE
	default n
	help
		Runs a serialize/parse round-trip at boot and logs PASS/FAIL.
		Diagnostic only - keep off in normal builds.

config SYNTH_DRUM_SYNTH_MODE
	bool "Synth (DX7/Juno) drum engine"
	default n
	help
		Compile the legacy Synth drum engine: a curated DX7/Juno patch
		list playable per drum track, selectable as the first entry of
		the Drum Bank menu item. When off, drum layers are PCM-only
		(808 ROM bank + gamma9001 sample banks) and projects saved with
		the Synth engine load as PCM.

config SEQ_OOM_RESYNC
	bool "Resync sequencer after AMY OOM bursts"
	default y
	help
		Poll AMY's OOM counter from the UI task; once a burst of
		allocation failures settles, re-emit every layer's scheduled
		steps and re-arm the arp. During an OOM window (e.g. an
		oversized patch load exhausting internal heap) scheduled
		events and tag cancels are dropped silently, leaving tracks
		mute until something re-emits them - this closes that window
		automatically. Disable to rule the hook out when debugging.

endmenu